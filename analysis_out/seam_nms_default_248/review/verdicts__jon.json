  {
   "rule": "Pair: is A the same physical object as B?",
   "detail": "same = one object marked twice; different = two distinct objects; unsure = cannot tell. The crops are rolled so the panorama seam is at the centre; the imagery there is continuous, so judge the world, not the projection."
  },
  {
   "rule": "Each mark: is it a curb ramp?",
   "detail": "ramp / not_ramp / unsure, for the object under the mark."
  },
  {
   "rule": "A driveway is NOT a curb ramp",
   "detail": "Driveway aprons are excluded however ramp-like they look."
  },
  {
   "rule": "Mark only what you can SEE",
   "detail": "Never call a ramp because a crossing implies one."
  },
  {
   "rule": "Unsure is a real answer",
   "detail": "An unsure verdict sends the card to a human; a coerced one is noise."
  }
